export function REAL_REASPO_SCAN() {

    const div = document.createElement("div");
    div.className = "real-scan";

    div.innerHTML = `
        <style>
            .real-scan {
                background:#111;
                color:#eee;
                padding:20px;
                margin:20px 0;
                border:1px solid #333;
                font-family:Consolas, monospace;
            }
            .real-scan h2 { color:#6cf; }
            .real-scan h3 { color:#ff0; margin-top:20px; }
            .json-block {
                background:#000;
                padding:10px;
                border-left:4px solid #6cf;
                white-space:pre-wrap;
            }
            .json-key   { color:#0ff; }
            .json-value { color:#f0f; }
            .json-true  { color:#0f0; }
            .json-false { color:#f00; }
        </style>

        <h2>REAL · REASPO · SCAN</h2>

        <h3>REAL (Echtzeit)</h3>
        <pre class="json-block">${colorJSON(structure.X)}</pre>

        <h3>REASPO (Response)</h3>
        <pre class="json-block">${colorJSON(structure.Q)}</pre>

        <h3>SCAN (Analyse)</h3>
        <pre class="json-block">${colorJSON(structure.TMP)}</pre>
    `;

    return div;
}

function colorJSON(obj) {
    return JSON.stringify(obj, null, 4)
        .replace(/"([^"]+)":/g, '<span class="json-key">"$1"</span>:')
        .replace(/: "([^"]+)"/g, ': <span class="json-value">"$1"</span>')
        .replace(/: true/g, ': <span class="json-true">true</span>')
        .replace(/: false/g, ': <span class="json-false">false</span>');
}

