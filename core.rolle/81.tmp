export function VIEW_81_MATRIX(matrix) {

    const div = document.createElement("div");
    div.className = "matrix81";

    div.innerHTML = `
        <style>
            .matrix81 {
                background:#111;
                color:#eee;
                padding:20px;
                border:1px solid #666;
                margin:20px 0;
            }
            .matrix81 h2 { color:#6cf; }
            .grid81 {
                display:grid;
                grid-template-columns:repeat(9,1fr);
                gap:4px;
                margin-top:20px;
            }
            .cell81 {
                background:#000;
                padding:6px;
                border-left:4px solid #6cf;
                font-size:12px;
                text-align:center;
            }
        </style>

        <h2>81.tmp · REAL‑RESPO‑Matrix</h2>

        <div class="grid81">
            ${Object.entries(matrix).map(([key,val]) => `
                <div class="cell81">${key}<br>${val}</div>
            `).join("")}
        </div>
    `;

    return div;
}
import matrix81 from "./81.room.js";

document.body.appendChild(VIEW_81_MATRIX(matrix81));
